#!/usr/bin/env bash
# Dumps the gogame database into /var/backups/gogame (compressed, one file per day, the last
# 14 kept), and copies it to S3 when GOGAME_BACKUP_S3 is set (e.g. s3://my-bucket/gogame),
# using the AWS CLI. Run every night by the gogame-backup timer (bin/install-server).
#
# Restore a dump with:
#   mongorestore --uri "$(grep -oE 'mongodb://[^"]+' conf/secrets.conf | head -1)" \
#     --archive=/var/backups/gogame/gogame-DATE.archive.gz --gzip --drop
set -euo pipefail
cd "$(dirname "$0")/.."

uri=$(grep -oE 'mongodb://[^"]+' conf/secrets.conf 2>/dev/null | head -1 || true)
uri="${uri:-mongodb://127.0.0.1:27017/gogame}"
backups=/var/backups/gogame
mkdir -p "$backups"
file="$backups/gogame-$(date -u +%Y-%m-%d).archive.gz"

mongodump --quiet --uri "$uri" --archive="$file.part" --gzip
mv "$file.part" "$file"
find "$backups" -name 'gogame-*.archive.gz' -mtime +14 -delete
echo "backup: $file ($(du -h "$file" | cut -f1))"

if [ -n "${GOGAME_BACKUP_S3:-}" ]; then
  aws s3 cp --only-show-errors "$file" "${GOGAME_BACKUP_S3%/}/$(basename "$file")"
  echo "copied to ${GOGAME_BACKUP_S3%/}/"
fi
